(executable
 (flags
  (:standard -g -w +a -w -3 -w -4 -w -42 -w -44 -w -49 -w -70 -warn-error +a))
 (ocamlopt_flags
  (:standard -g -w +a -w -3 -w -4 -w -42 -w -44 -w -49 -w -70 -warn-error +a))
 (libraries
  chyron
  core
  ; core_bench
